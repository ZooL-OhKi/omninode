[Unit]
Description=OmniNode Gateway Controller (Live Pilot)
After=network.target mosquitto.service

[Service]
Type=simple
User=omninode
WorkingDirectory=/opt/omninode/node1-gateway
ExecStart=/opt/omninode/node1-gateway/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omninode-gateway

[Install]
WantedBy=multi-user.target