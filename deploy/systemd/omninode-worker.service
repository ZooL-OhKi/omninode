[Unit]
Description=OmniNode Fleet Worker (mTLS v1)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=omninode
Group=omninode
WorkingDirectory=/opt/omninode/omniclient
EnvironmentFile=/etc/omninode/omninode-worker.env
ExecStartPre=/usr/bin/test -r /etc/omninode/certs/ca.crt
ExecStartPre=/usr/bin/test -r /etc/omninode/certs/worker-1.crt
ExecStartPre=/usr/bin/test -r /etc/omninode/certs/worker-1.key
ExecStart=/opt/omninode/omniclient/omniclient
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/omninode/workspace
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omninode-worker

[Install]
WantedBy=multi-user.target
