# API authentication. Generate a long random value and store it only in the deployment secret manager.
OMNINODE_API_KEY=replace-with-a-long-random-secret

# MQTT broker configuration
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false
MQTT_KEEPALIVE=60

# Node heartbeat TTL in seconds
NODE_TTL_SECONDS=90
