{
  "manifest_version": 3,
  "name": "OmniNode Bridge",
  "version": "0.3.2",
  "description": "Bridge desktop locale. Attivazione Perplexity e controllo Gemini; consegna automatica Perplexity non ancora implementata.",
  "permissions": ["activeTab", "tabs", "nativeMessaging"],
  "background": {"service_worker": "service_worker.js"},
  "action": {"default_title": "OmniNode Desktop", "default_popup": "desktop.html"},
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["action_policy.js", "task_delivery.js", "text_delivery.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://perplexity.ai/*", "https://www.perplexity.ai/*"],
      "js": ["perplexity_content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
