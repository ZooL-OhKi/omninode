{
  "manifest_version": 3,
  "name": "OmniNode Bridge",
  "version": "0.1.0",
  "description": "Collega una sessione Gemini esplicitamente attivata al core OmniNode locale.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OmniNode Bridge"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
